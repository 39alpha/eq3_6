  'src/xcon3/wr3w7.f90',
  'src/xcon3/wr3w8.f90',
  'src/xcon3/xcon3.f90',
)
xcon6_sources = files(
  'src/xcon6/aaaxc6.f90',
  'src/xcon6/bkdxc6.f90',
  'src/xcon6/rd6d7.f90',
  'src/xcon6/rd6d8b.f90',
  'src/xcon6/rd6d8.f90',
  'src/xcon6/rd6dvz.f90',
  'src/xcon6/rd6w6.f90',
  'src/xcon6/rd6w72.f90',
  'src/xcon6/rd6w7.f90',
  'src/xcon6/rd6w8.f90',
  'src/xcon6/rd6wvz.f90',
  'src/xcon6/wr6d72.f90',
  'src/xcon6/wr6d7.f90',
  'src/xcon6/wr6d8.f90',
  'src/xcon6/wr6w6.f90',
  'src/xcon6/wr6w72.f90',
  'src/xcon6/wr6w7.f90',
  'src/xcon6/wr6w8.f90',
  'src/xcon6/xcon6.f90',
)

eqlibu_static = static_library(
  'equ',
  eqlibu_sources,
  pic: true,
  install: true,
  include_directories: incs,
)

eqlibu_shared = shared_library(
  'equ',
  objects: eqlibu_static.extract_all_objects(recursive: true),
  version: meson.project_version(),
  soversion: '0',
  install: true,
  include_directories: incs,
)

eqlibu_dep = declare_dependency(
  link_with: eqlibu_static,
)

eqlibu_shared_dep = declare_dependency(
  link_with: eqlibu_shared,
)

eqlibg_static = static_library(
  'eqg',
  eqlibg_sources,
  pic: true,
  install: true,
  include_directories: incs,
)

eqlibg_shared = shared_library(
  'eqg',
  objects: eqlibg_static.extract_all_objects(recursive: true),
  version: meson.project_version(),
  soversion: '0',
  install: true,
  include_directories: incs,
  dependencies: eqlibu_shared_dep,
)

eqlibg_dep = declare_dependency(
  link_with: eqlibg_static,
)

eqlibg_shared_dep = declare_dependency(
  link_with: eqlibg_shared,
)

eqlib_static = static_library(
  'eq',
  eqlib_sources,
  pic: true,
  install: true,
  include_directories: incs,
)

eqlib_shared = shared_library(
  'eq',
  objects: eqlib_static.extract_all_objects(recursive: true),
  version: meson.project_version(),
  soversion: '0',
  install: true,
  include_directories: incs,
  dependencies: [eqlibu_shared_dep, eqlibg_shared_dep],
)

eqlib_dep = declare_dependency(
  link_with: eqlib_static,
)

eqlib_shared_dep = declare_dependency(
  link_with: eqlib_shared,
)

executable(
  'eqpt',
  eqpt_sources,
  dependencies: eqlibu_dep,
  install: true,
  include_directories: incs,
)

executable(
  'eq3nr',
  eq3nr_sources,
  dependencies: [eqlib_dep, eqlibu_dep, eqlibg_dep],
  install: true,
  include_directories: incs,
)

executable(
  'eq6',
  eq6_sources,
  dependencies: [eqlib_dep, eqlibu_dep, eqlibg_dep],
  install: true,
  include_directories: incs,
)

executable(
  'xcon3',
  xcon3_sources,
  dependencies: eqlibu_dep,
  install: true,
  include_directories: incs,
)

executable(
  'xcon6',
  xcon6_sources,
  dependencies: eqlibu_dep,
  install: true,
  include_directories: incs,
)

